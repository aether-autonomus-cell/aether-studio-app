{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "kr.job.v1"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "story_revision_id": {
      "type": "string",
      "minLength": 1
    },
    "settings_revision_id": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8
    },
    "confirmed_by_user": {
      "type": "boolean",
      "const": true
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "claimed",
        "running",
        "paused_quota",
        "paused_user",
        "failed",
        "completed",
        "cancelled"
      ]
    },
    "fps": {
      "type": "number",
      "const": 24
    },
    "sample_rate": {
      "type": "number",
      "const": 48000
    },
    "zero_spend": {
      "type": "object",
      "properties": {
        "paid_routes": {
          "type": "boolean",
          "const": false
        },
        "allow_billing_fallback": {
          "type": "boolean",
          "const": false
        },
        "allowed_free_routes": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "colab-free-gpu",
              "local-studio-preview",
              "google-gemini-free-tier",
              "groq-free-tier",
              "openrouter-free-tier",
              "deterministic-local-director"
            ]
          }
        },
        "pause_on_quota_exhaustion": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "paid_routes",
        "allow_billing_fallback",
        "allowed_free_routes",
        "pause_on_quota_exhaustion"
      ],
      "additionalProperties": false
    },
    "lease_token": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "lease_expires_at": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "worker_session_id": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "current_scene_index": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "scenes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scene_id": {
            "type": "string",
            "minLength": 1
          },
          "order_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "chapter_title": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "mood": {
            "type": "string",
            "minLength": 1
          },
          "camera_direction": {
            "type": "string",
            "minLength": 1
          },
          "visual_prompt": {
            "type": "string",
            "minLength": 1
          },
          "negative_prompt": {
            "default": "text, watermark, signature, low quality, blurry, deformed",
            "type": "string"
          },
          "seed": {
            "default": 104729,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "hi_narration": {
            "type": "string",
            "minLength": 1
          },
          "en_narration": {
            "type": "string",
            "minLength": 1
          },
          "sfx_cues": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "whoosh",
                "thump",
                "rumble",
                "crash",
                "creak",
                "ding",
                "pop"
              ]
            }
          },
          "ambience_profile": {
            "default": "warm_room",
            "type": "string",
            "enum": [
              "none",
              "rain",
              "wind",
              "temple_hall",
              "night_forest",
              "warm_room"
            ]
          },
          "target_duration_sec": {
            "default": 8,
            "type": "number",
            "minimum": 2,
            "maximum": 60
          },
          "locked_canon": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "scene_id",
          "order_index",
          "chapter_title",
          "title",
          "location",
          "mood",
          "camera_direction",
          "visual_prompt",
          "negative_prompt",
          "seed",
          "hi_narration",
          "en_narration",
          "sfx_cues",
          "ambience_profile",
          "target_duration_sec",
          "locked_canon"
        ],
        "additionalProperties": false
      }
    },
    "checkpoints": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scene_id": {
            "type": "string",
            "minLength": 1
          },
          "order_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "stage": {
            "type": "string",
            "enum": [
              "queued",
              "image",
              "speech_hi",
              "speech_en",
              "timing",
              "compose",
              "verify",
              "drive_save",
              "ready",
              "timeline_append",
              "failed"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "completed",
              "blocked",
              "failed"
            ]
          },
          "attempt": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "image_drive_id": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "image_local_path": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "hi_audio_drive_id": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "hi_audio_samples": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "en_audio_drive_id": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "en_audio_samples": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "composed_mp4_drive_id": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "duration_frames": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "verified": {
            "default": false,
            "type": "boolean"
          },
          "error_code": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "error_message": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "updated_at": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "scene_id",
          "order_index",
          "stage",
          "status",
          "attempt",
          "image_drive_id",
          "image_local_path",
          "hi_audio_drive_id",
          "hi_audio_samples",
          "en_audio_drive_id",
          "en_audio_samples",
          "composed_mp4_drive_id",
          "duration_frames",
          "verified",
          "error_code",
          "error_message",
          "updated_at"
        ],
        "additionalProperties": false
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "director_route": {
          "default": "deterministic-local-director",
          "type": "string",
          "enum": [
            "colab-free-gpu",
            "local-studio-preview",
            "google-gemini-free-tier",
            "groq-free-tier",
            "openrouter-free-tier",
            "deterministic-local-director"
          ]
        },
        "image_baseline": {
          "type": "object",
          "properties": {
            "model_id": {
              "type": "string",
              "const": "black-forest-labs/FLUX.2-klein-4B"
            },
            "model_revision": {
              "type": "string",
              "const": "e7b7dc27f91deacad38e78976d1f2b499d76a294"
            },
            "width": {
              "type": "number",
              "const": 1344
            },
            "height": {
              "type": "number",
              "const": 768
            },
            "steps": {
              "default": 4,
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "guidance_scale": {
              "default": 1,
              "type": "number",
              "minimum": 0.5,
              "maximum": 3
            },
            "grade_profile": {
              "type": "string",
              "const": "restrained-v1"
            },
            "text_encoder": {
              "type": "string",
              "const": "Qwen3ForCausalLM-NF4-FP32"
            }
          },
          "required": [
            "model_id",
            "model_revision",
            "width",
            "height",
            "steps",
            "guidance_scale",
            "grade_profile",
            "text_encoder"
          ],
          "additionalProperties": false
        },
        "voices": {
          "type": "object",
          "properties": {
            "hi": {
              "type": "object",
              "properties": {
                "language": {
                  "type": "string",
                  "enum": [
                    "hi",
                    "en"
                  ]
                },
                "provider": {
                  "type": "string",
                  "enum": [
                    "edge_tts_free",
                    "chatterbox_colab",
                    "indic_parler_colab",
                    "browser_speech_preview"
                  ]
                },
                "voice_id": {
                  "type": "string",
                  "minLength": 1
                },
                "speaking_rate": {
                  "default": 1,
                  "type": "number",
                  "minimum": 0.75,
                  "maximum": 1.35
                }
              },
              "required": [
                "language",
                "provider",
                "voice_id",
                "speaking_rate"
              ],
              "additionalProperties": false
            },
            "en": {
              "type": "object",
              "properties": {
                "language": {
                  "type": "string",
                  "enum": [
                    "hi",
                    "en"
                  ]
                },
                "provider": {
                  "type": "string",
                  "enum": [
                    "edge_tts_free",
                    "chatterbox_colab",
                    "indic_parler_colab",
                    "browser_speech_preview"
                  ]
                },
                "voice_id": {
                  "type": "string",
                  "minLength": 1
                },
                "speaking_rate": {
                  "default": 1,
                  "type": "number",
                  "minimum": 0.75,
                  "maximum": 1.35
                }
              },
              "required": [
                "language",
                "provider",
                "voice_id",
                "speaking_rate"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "hi",
            "en"
          ],
          "additionalProperties": false
        },
        "caption_style": {
          "default": "single_active_lang",
          "type": "string",
          "enum": [
            "bilingual_lower",
            "single_active_lang",
            "minimal_cinema"
          ]
        },
        "zero_spend": {
          "type": "object",
          "properties": {
            "paid_routes": {
              "type": "boolean",
              "const": false
            },
            "allow_billing_fallback": {
              "type": "boolean",
              "const": false
            },
            "allowed_free_routes": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "colab-free-gpu",
                  "local-studio-preview",
                  "google-gemini-free-tier",
                  "groq-free-tier",
                  "openrouter-free-tier",
                  "deterministic-local-director"
                ]
              }
            },
            "pause_on_quota_exhaustion": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "paid_routes",
            "allow_billing_fallback",
            "allowed_free_routes",
            "pause_on_quota_exhaustion"
          ],
          "additionalProperties": false
        },
        "drive_export_folder_id": {
          "default": "15ek6wQirJz7d0DCLf6fvFWtMRvWpcLHx",
          "type": "string"
        }
      },
      "required": [
        "director_route",
        "image_baseline",
        "voices",
        "caption_style",
        "zero_spend",
        "drive_export_folder_id"
      ],
      "additionalProperties": false
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "job_id",
    "project_id",
    "story_revision_id",
    "settings_revision_id",
    "idempotency_key",
    "confirmed_by_user",
    "status",
    "fps",
    "sample_rate",
    "zero_spend",
    "lease_token",
    "lease_expires_at",
    "worker_session_id",
    "current_scene_index",
    "scenes",
    "checkpoints",
    "settings",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false
}
