          "type": "object",
          "properties": {
            "save_to_drive": {
              "default": true,
              "type": "boolean"
            },
            "drive_folder": {
              "default": "AetherStudioExports",
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "captions": {
              "default": [
                "srt",
                "vtt"
              ],
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "srt",
                  "vtt"
                ]
              }
            }
          },
          "required": [
            "save_to_drive",
            "drive_folder",
            "captions"
          ],
          "additionalProperties": false
