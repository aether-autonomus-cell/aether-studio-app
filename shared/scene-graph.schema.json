{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "aether.2d.job@1"
    },
    "project_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64
    },
    "project_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "project": {
      "type": "object",
      "properties": {
        "title": {
          "type": "object",
          "properties": {
            "hi-IN": {
              "default": "",
              "type": "string",
              "maxLength": 4000
