            "en-US": {
              "default": "",
              "type": "string",
              "maxLength": 4000
            }
          },
          "required": [
            "hi-IN",
            "en-US"
          ],
          "additionalProperties": false
        },
        "mode": {
          "default": "manhwa-anime",
          "type": "string",
          "enum": [
            "story",
            "explainer",
            "manhwa-anime"
          ]
        },
        "visual_mode": {
          "default": "pure-2d",
          "type": "string",
          "enum": [
            "pure-2d",
            "hybrid-2d"
          ]
        },
        "languages": {
          "default": [
            "hi-IN",
            "en-US"
