          "default": {
            "hi-IN": {
              "channel_slot": "hindi",
              "title": "",
              "description": "",
              "tags": [
                "story",
                "hindi",
                "aetherstudio"
              ],
              "privacy_status": "private",
              "made_for_kids": false
            },
            "en-US": {
              "channel_slot": "english",
              "title": "",
              "description": "",
              "tags": [
                "story",
                "animation",
                "aetherstudio"
              ],
              "privacy_status": "private",
              "made_for_kids": false
            }
          },
          "type": "object",
          "properties": {
            "hi-IN": {
              "type": "object",
              "properties": {
                "channel_slot": {
                  "type": "string",
                  "enum": [
                    "hindi",
                    "english"
                  ]
                },
                "title": {
                  "default": "",
                  "type": "string",
                  "maxLength": 100
                },
                "description": {
                  "default": "",
                  "type": "string",
                  "maxLength": 5000
                },
                "tags": {
                  "default": [],
                  "maxItems": 25,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 40
                  }
                },
                "privacy_status": {
                  "default": "private",
                  "type": "string",
                  "enum": [
                    "private",
                    "unlisted",
                    "public"
                  ]
                },
                "made_for_kids": {
                  "default": false,
                  "type": "boolean"
                }
              },
              "required": [
                "channel_slot",
                "title",
                "description",
                "tags",
                "privacy_status",
                "made_for_kids"
              ],
              "additionalProperties": false
            },
            "en-US": {
              "type": "object",
              "properties": {
                "channel_slot": {
                  "type": "string",
                  "enum": [
                    "hindi",
                    "english"
                  ]
                },
                "title": {
                  "default": "",
                  "type": "string",
                  "maxLength": 100
                },
                "description": {
                  "default": "",
                  "type": "string",
                  "maxLength": 5000
                },
                "tags": {
                  "default": [],
                  "maxItems": 25,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 40
                  }
                },
                "privacy_status": {
                  "default": "private",
                  "type": "string",
                  "enum": [
                    "private",
                    "unlisted",
                    "public"
                  ]
                },
                "made_for_kids": {
                  "default": false,
                  "type": "boolean"
                }
              },
              "required": [
                "channel_slot",
                "title",
                "description",
                "tags",
                "privacy_status",
                "made_for_kids"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "hi-IN",
            "en-US"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "title",
        "mode",
        "visual_mode",
        "languages",
        "voices",
        "aspect_ratio",
        "resolution",
        "fps",
        "seed",
        "style_id",
        "scenes",
        "bgm",
        "outputs",
        "publish_targets"
      ],
      "additionalProperties": false
    }
