          "minItems": 1,
          "maxItems": 2,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "hi-IN",
              "en-US"
            ]
          }
        },
        "voices": {
          "default": {
            "hi-IN": "hi-IN-MadhurNeural",
            "en-US": "en-US-ChristopherNeural"
