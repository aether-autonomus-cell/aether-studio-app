        "style_id": {
          "default": "midnight-cyan@1",
          "type": "string",
          "enum": [
            "midnight-cyan@1",
            "crimson-sakuga@1",
            "amber-explainer@1",
            "obsidian-gold@1"
          ]
        },
        "scenes": {
          "minItems": 1,
          "maxItems": 120,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "template_id": {
                "type": "string",
                "enum": [
                  "hook-card@1",
                  "manhwa-dialogue@1",
                  "action-pan@1",
                  "cause-effect@1",
                  "comparison@1",
                  "recap-payoff@1",
                  "custom-canvas@1"
                ]
              },
              "narration": {
                "type": "object",
                "properties": {
                  "hi-IN": {
                    "default": "",
                    "type": "string",
                    "maxLength": 4000
