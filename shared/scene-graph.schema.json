          "type": "object",
          "properties": {
            "hi-IN": {
              "default": "hi-IN-MadhurNeural",
              "type": "string"
            },
            "en-US": {
              "default": "en-US-ChristopherNeural",
              "type": "string"
            }
          },
          "required": [
            "hi-IN",
            "en-US"
          ],
          "additionalProperties": false
        },
        "aspect_ratio": {
          "default": "9:16",
          "type": "string",
          "enum": [
            "9:16",
            "16:9"
          ]
        },
        "resolution": {
          "default": "1080p",
          "type": "string",
          "enum": [
            "1080p",
            "540p"
          ]
        },
        "fps": {
          "default": 30,
          "anyOf": [
            {
              "type": "number",
              "const": 24
            },
            {
              "type": "number",
              "const": 30
            }
          ]
        },
        "seed": {
          "default": 42,
          "type": "integer",
          "minimum": 0,
          "maximum": 999999
