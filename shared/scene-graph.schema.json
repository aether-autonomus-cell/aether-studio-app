                    "additionalProperties": false
                  },
                  "customCode": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "default": "canvas2d",
                        "type": "string",
                        "enum": [
                          "canvas2d",
                          "svg",
                          "p5"
                        ]
                      },
                      "code": {
                        "type": "string",
                        "maxLength": 40000
                      }
                    },
                    "required": [
                      "kind",
                      "code"
                    ],
                    "additionalProperties": false
                  }
