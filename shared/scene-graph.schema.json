            "required": [
              "id",
              "template_id",
              "narration",
              "duration_hint_sec",
              "pause_after_ms",
              "transition",
              "props",
              "camera"
            ],
            "additionalProperties": false
          }
        },
        "bgm": {
          "default": null,
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "track_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "volume": {
                  "default": 0.14,
                  "type": "number",
                  "minimum": 0,
                  "maximum": 0.5
                },
                "drive_file_id": {
                  "type": "string",
                  "maxLength": 128
                }
              },
              "required": [
                "track_id",
                "volume"
              ],
              "additionalProperties": false
