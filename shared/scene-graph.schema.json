                    "required": [
                      "nodes",
                      "edges",
                      "activeStep"
                    ],
                    "additionalProperties": false
                  },
                  "backdrop": {
                    "type": "object",
                    "properties": {
                      "mood": {
                        "default": "skyline",
                        "type": "string",
                        "enum": [
                          "skyline",
                          "temple",
                          "void-grid",
                          "storm"
                        ]
