                "additionalProperties": false
              },
              "camera": {
                "default": [
                  {
                    "at": 0,
                    "x": 0.5,
                    "y": 0.5,
                    "zoom": 1,
                    "shake": 0
                  }
                ],
                "minItems": 1,
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "at": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "x": {
                      "default": 0.5,
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "y": {
                      "default": 0.5,
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "zoom": {
                      "default": 1,
                      "type": "number",
                      "minimum": 0.5,
                      "maximum": 2.5
                    },
                    "shake": {
                      "default": 0,
                      "type": "number",
                      "minimum": 0,
                      "maximum": 0.25
                    }
                  },
                  "required": [
                    "at",
                    "x",
                    "y",
                    "zoom",
                    "shake"
                  ],
                  "additionalProperties": false
                }
              }
