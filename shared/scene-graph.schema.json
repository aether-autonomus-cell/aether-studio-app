                      "en-US": {
                        "default": "",
                        "type": "string",
                        "maxLength": 4000
                      }
                    },
                    "required": [
                      "hi-IN",
                      "en-US"
                    ],
                    "additionalProperties": false
                  },
                  "subhead": {
                    "type": "object",
                    "properties": {
                      "hi-IN": {
                        "default": "",
                        "type": "string",
                        "maxLength": 4000
                      },
                      "en-US": {
                        "default": "",
                        "type": "string",
                        "maxLength": 4000
                      }
                    },
                    "required": [
                      "hi-IN",
                      "en-US"
                    ],
                    "additionalProperties": false
                  },
                  "emphasis": {
                    "maxItems": 12,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 80
                    }
                  },
                  "character": {
                    "type": "object",
                    "properties": {
                      "archetype": {
                        "default": "hero-noir",
                        "type": "string",
                        "enum": [
                          "hero-noir",
                          "mentor-sage",
                          "rival-crimson",
                          "analyst-cyan"
                        ]
                      },
                      "pose": {
                        "default": "determined",
                        "type": "string",
                        "enum": [
                          "idle",
                          "determined",
                          "pointing",
                          "stride",
                          "shocked"
