                          "required": [
                            "id",
                            "label"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "edges": {
                        "maxItems": 10,
                        "type": "array",
                        "items": {
                          "type": "array",
                          "prefixItems": [
                            {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            }
                          ],
                          "items": false,
                          "minItems": 2,
                          "maxItems": 2
                        }
                      },
                      "activeStep": {
                        "default": 0,
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 5
                      }
